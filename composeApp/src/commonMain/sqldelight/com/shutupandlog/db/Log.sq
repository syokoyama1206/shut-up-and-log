CREATE TABLE food_master (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    unit TEXT NOT NULL,
    mode TEXT NOT NULL,
    reference_amount REAL NOT NULL CHECK(reference_amount > 0),
    protein REAL NOT NULL CHECK(protein >= 0),
    fat REAL NOT NULL CHECK(fat >= 0),
    carbs REAL NOT NULL CHECK(carbs >= 0),
    updated_at INTEGER NOT NULL
);
CREATE TABLE meal_entry (
    id TEXT NOT NULL PRIMARY KEY,
    food_id TEXT NOT NULL,
    date TEXT NOT NULL,
    name TEXT NOT NULL,
    amount REAL NOT NULL CHECK(amount > 0),
    unit TEXT NOT NULL,
    protein REAL NOT NULL CHECK(protein >= 0),
    fat REAL NOT NULL CHECK(fat >= 0),
    carbs REAL NOT NULL CHECK(carbs >= 0),
    created_at INTEGER NOT NULL
);
CREATE INDEX meal_date ON meal_entry(date);
CREATE TABLE workout_entry (
    id TEXT NOT NULL PRIMARY KEY,
    date TEXT NOT NULL,
    exercise TEXT NOT NULL,
    category TEXT NOT NULL,
    created_at INTEGER NOT NULL
);
CREATE TABLE workout_set (
    workout_id TEXT NOT NULL,
    set_order INTEGER NOT NULL,
    weight_kg REAL NOT NULL CHECK(weight_kg >= 0),
    reps INTEGER NOT NULL CHECK(reps > 0),
    PRIMARY KEY(workout_id, set_order),
    FOREIGN KEY(workout_id) REFERENCES workout_entry(id) ON DELETE CASCADE
);
CREATE INDEX workout_date ON workout_entry(date);

allFoods:
SELECT * FROM food_master ORDER BY updated_at DESC, id;
allMeals:
SELECT * FROM meal_entry ORDER BY created_at DESC, id;
upsertFood:
INSERT OR REPLACE INTO food_master VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);
insertMeal:
INSERT INTO meal_entry VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
deleteMeal:
DELETE FROM meal_entry WHERE id = ?;
allWorkouts:
SELECT workout_entry.id, date, exercise, category, created_at, set_order, weight_kg, reps
FROM workout_entry JOIN workout_set ON workout_entry.id = workout_set.workout_id
ORDER BY date DESC, created_at DESC, set_order;
insertWorkout:
INSERT INTO workout_entry VALUES (?, ?, ?, ?, ?);
insertWorkoutSet:
INSERT INTO workout_set VALUES (?, ?, ?, ?);
deleteWorkout:
DELETE FROM workout_entry WHERE id = ?;
deleteWorkoutSets:
DELETE FROM workout_set WHERE workout_id = ?;
